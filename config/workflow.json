{
  "schemaVersion": 1,
  "baseBranch": "main",
  "branchPrefixes": ["codex", "claude"],
  "highRiskPaths": [
    "AGENTS.md", "CLAUDE.md", ".github/", ".codex/", ".claude/",
    "config/", "tools/", "specs/", "docs/workflow.md", "docs/verification.md",
    "docs/agent-contracts/", "docs/deploy/", "next.config.mjs", "public/_headers",
    "package.json", "package-lock.json", ".node-version", ".python-version", ".npmrc"
  ],
  "review": {
    "normal": "independent-opposite-family",
    "high": ["openai", "anthropic"],
    "bindToHead": true,
    "enforcement": "owner-reviewed"
  },
  "requiredChecks": ["Repository checks", "Browser checks"]
}
